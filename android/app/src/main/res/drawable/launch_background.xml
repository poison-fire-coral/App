<?xml version="1.0" encoding="utf-8"?>
<!--
  체크리스트 33번 — 런치 스크린(라이트).

  Flutter 엔진이 첫 프레임을 그리기 전까지 보이는 화면이다. 앱 안의
  SplashScreen(1a)과는 다른 것으로, 이건 안드로이드가 그린다.

  두 화면의 바탕색을 같게 맞춰야 한다. 다르면 시작할 때 색이 한 번 튄다.
  #FBF6F3 은 AppColors.ink50 — 앱 바탕색이다.

  splash_logo.png 는 tool/generate_app_icon.dart 가 logo.svg 에서 굽는다.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
