<?xml version="1.0" encoding="utf-8"?>
<!--
  체크리스트 33번 — 런치 스크린(API 21+ 라이트).

  **drawable/ 과 같은 내용을 들고 있어야 한다.** 리소스 우선순위상 API 21
  이상에서는 이 파일이 drawable/launch_background.xml 을 이긴다. 한쪽만
  고치면 실기기에서는 옛 화면이 그대로 뜬다 — 요즘 기기는 전부 여기를 본다.

  다크 모드는 drawable-night/ 가 가져간다 (night 한정자가 버전보다 앞선다).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
