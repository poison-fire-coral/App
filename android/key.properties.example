# 릴리스 서명 키. 이 파일을 `key.properties` 로 복사해 값을 채운다.
#
# **key.properties 와 .jks 는 저장소에 넣지 않는다** (android/.gitignore).
#
# ⚠️ 원스토어에는 구글 플레이의 "앱 서명" 같은 관리형 키가 없다.
#    이 키스토어를 잃으면 **앱을 영영 업데이트할 수 없다.**
#    파일과 비밀번호를 서로 다른 두 곳에 오프라인으로 보관할 것.
#
# 키스토어 만들기:
#   keytool -genkey -v -keystore ~/localquest-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias localquest
#
# 만든 뒤 SHA-1 을 확인해 Firebase(구글 로그인)와 카카오 개발자 콘솔에 등록한다:
#   keytool -list -v -keystore ~/localquest-release.jks -alias localquest

storeFile=C:/경로/localquest-release.jks
storePassword=
keyAlias=localquest
keyPassword=
