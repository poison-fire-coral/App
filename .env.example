# 체크리스트 03번 — 서버가 읽는 환경 변수의 "이름만" 적어 둔다.
#
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 .gitignore 에 걸려 있다.
# 값은 절대 여기 쓰지 말 것 — 이 파일은 저장소에 그대로 남는다.
#
#   cp .env.example .env
#
# 앱 쪽 대응 파일은 dart_defines.example.json,
# iOS 네이티브 키는 ios/Flutter/Secrets.example.xcconfig 다.

# ─── 필수 ────────────────────────────────────────────────────────────────────

# PostgreSQL 접속 문자열. Prisma가 읽는다.
#   postgresql://<user>:<password>@<host>:5432/<db>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localquest?schema=public"

# 액세스·리프레시 토큰 서명 키. 운영과 개발에서 서로 다른 값을 쓴다.
# 이 값이 새면 남의 계정으로 토큰을 발급할 수 있다.
JWT_SECRET="local_quest_secret_key_2026_dev"

# ─── 선택 (없어도 서버는 뜬다) ────────────────────────────────────────────────

# API 서버 포트. 앱의 API_BASE_URL 과 맞춰야 한다. 기본 5001.
PORT=5001

# 'production' 이면 GUEST 로그인이 막힌다 (auth.service.ts:46).
# 로컬·테스트에서는 비워 두거나 development 로 둔다.
NODE_ENV=development

# 카카오 로그인 토큰 검증용 REST API 키.
# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > REST API 키.
KAKAO_REST_API_KEY="4caed0ec0b22469751e4ab1ae053c84a"

# 한국관광공사 TourAPI 서비스 키. 없으면 실시간 장소 검색만 스킵된다.
TOUR_API_SERVICE_KEY="dRQ286ua4z4EbA%2BwYbCzzW8vUixHmVytZe82E1V%2F8xj7ARXhXoxO2jio8QKFDL03lid1E5ptzeQSpkDA9Dg32g%3D%3D"

# ─── S3 (인증 사진 업로드) ───────────────────────────────────────────────────
# 자격 증명은 여기 두지 않는다. EC2/ECS 라면 IAM 역할, 로컬이라면
# `aws configure` 로 ~/.aws/credentials 에 둔다 — AWS SDK가 알아서 찾는다.


# 기본 ap-northeast-2
AWS_REGION=ap-northeast-2

# 사진이 올라갈 버킷. 기본 localquest-bucket
AWS_S3_BUCKET_NAME="local-quest-bucket-2026-339712801984-ap-northeast-2-an"

# ─── 푸시 알림 (체크리스트 24번) ──────────────────────────────────────────────
# 둘 중 하나만 주면 된다. 아무것도 없으면 발송이 조용히 꺼지고 서버는 정상 기동한다.

# 서비스 계정 JSON 파일 경로. 로컬 개발에 편하다.
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성.
GOOGLE_APPLICATION_CREDENTIALS="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQDQosx4Rul9A+6v\nwgILe5p5N/O4rKJFckv+5VJ88QqEMpCa8w/7akSM7D+90QmmmiI5M0Ft4VeU1g89\nvJFPXhogvXTgX/47Rv7HW+6iVCKEDIrWCKorYlXqS6m8f9HTXaMpgdADYIcTdJIE\nizcHb5oCNWj3B6+8VeFxmCyNEVuwHbVEt5/yqgsxj1YN6V6704M9SDo0KV7tSfB+\n/svDAQMRTLOVEL/jGFvLtqnxU8nUFCzt2hv8+Y7LOo3f2emLdyg6OtA/Ktiojpvb\nuKxCF8s4EfrrF9y1ONrtnvkvLOlcJSN3LKKb3BlS28i62BR6b/BeqdiD/r6y/eWW\nxySY6dB9AgMBAAECggEAGZWFFlC3zBVB3TqgrpDLKgcy81f0FCkGaazsVxblz701\nn1KkCJQI8PD9hgTOtqfa/4GqCdPivgUb3Fm1xfJHqPEilmsfDVzQ3FiJJE3F58Rz\n9/gbCfPmjjMWDt/rtowaeHoLLIbXOYsHZtg9eMN2MsQi6Xv/UEyFtzzOZcQVprxd\nCkjPtSmtYAh8SAd7K++StMw5ApJLTK4Gl/JDrkx5f9NMK8K0MjqBbY80aitXzlQu\nmfEcpLHir5jzWqBg5XRR4gLx4MAY98oV7jnHCMqLiM//yeSGp6uoQ00y6WQoGKos\noWZUaTA31ls4Tnp819aruNqHdRkfe8ku1f+Y/q9PEQKBgQD49nFYw8EFHP9vcPBv\nuLDMLDl5VMga88ZhUuCSgeLVdZtTBDme6ESvszDJEuaCrI7RoG9tg4je4EbGEltb\n+peaoV/9sD96gTZKW/TkoKQqfL7kdOKNGYdlxVAUFD1RxYhO+eDKLo+9PD0GqkVi\n6Cmmi6RjqAEC4oy0+/cknDaT6QKBgQDWiIqbR8bHXiKIpDYCMP+fZxluS8F4gPs+\nlLelx/xOocSFoHgTbYNclaC/pgEJXeWv99kqro6SFiB9c5PAZTWlQSoUljcEAjNk\nTKGjpg1ZHG6z19lD8W+dvdnizw5Q/PgNaU8Jc2DfkOyfITlAXY39xUCJdxrYoTJF\n5NAgqTcfdQKBgQCjH+7Cp3jIXeisX0bbHRuSnAOIkVmP91xrln8Y38v961I7gdAz\nY6LlsLZteVnaEzB8/+8ixYWf6znUPGDqEnbVVZlswtfE7/bfoAME7pDCWfxF+qQa\nqbiCoVdH4L8Q3ini/W0hbIK4Dkk6HcTa+p2Xx3WN6p3HAyQIzfNwZH6KSQKBgQCi\nAdzCJLL9DZ6Al5ldkEkJxF7VBwpkiOqyuLXy0JI9gzYYPzVOXo4r1abd82um+iyg\n9UcfT1DFC0af1i8GxKd9UzeG8mU7drn+jUwnfBdqaulCkMc24tWKRruK5xgFmvNr\nlVIlbecDDbtS9FD6xWub72CsLrCsVRbU51UwxPimnQKBgE7z0vzf1qFyX9qvh/DT\nCuN9QojsU12nlXkNy80JOo2r1TdcNVc++4wF24hrz1iI5N66VvJ62gh70KG8lK6k\nAWgnaSPU2whrwMVUj0FpJpultWn5pM9kQoR027hwmhj1JxZx3buuL8rSCf29yVg1\nzjGpkyIxEwROBve+95SKul14\n-----END PRIVATE KEY-----\n"

# 위 JSON 을 한 줄로 통째로. 파일을 둘 수 없는 배포 환경용.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── 운영 배포에서 추가로 보는 것 ────────────────────────────────────────────

# 브라우저에서 이 API를 부를 수 있는 오리진(쉼표 구분).
# **앱은 여기 없어도 된다** — Flutter의 http 클라이언트는 Origin 헤더를 보내지
# 않아 CORS 검사를 거치지 않는다. 여기서 막는 것은 다른 웹사이트가 방문자의
# 브라우저로 우리 API를 부르는 경우다. 비우면 브라우저 요청을 전부 막는다.
CORS_ORIGINS=https://chewing-asleep-vest.ngrok-free.dev

# ngrok 지금 이거로 돌리는데 이거 터미널 입력버전
# ngrok http --url=chewing-asleep-vest.ngrok-free.dev 5001



# 이 인스턴스가 배치(혼잡도 계산·주변 퀘스트 알림)를 돌릴지.
# 크론이 프로세스 안에서 돌아서, 인스턴스를 둘로 늘리면 두 번씩 나간다.
# 여러 대로 늘릴 때는 한 대만 true 로 둔다. 기본 true.
RUN_JOBS=true

# 어뷰징 로그(GET /quests/abuse-logs)를 볼 수 있는 사용자 id(쉼표 구분).
# 응답에 남의 닉네임과 제공자 회원번호가 들어가므로 비우면 아무도 못 본다.
ADMIN_USER_IDS=
